{
  "manifest_version": 3,
  "name": "Loom",
  "version": "0.1.0",
  "description": "A cozy study buddy that breaks any page into small steps, keeps your notes and deadlines, and cheers you on.",
  "permissions": ["storage", "alarms", "sidePanel", "notifications", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "action": {
    "default_title": "Open Loom",
    "default_icon": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png" }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/config.js", "shared/store.js", "shared/pet.js", "shared/roam.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["assets/pets/*"], "matches": ["<all_urls>"] }
  ]
}
